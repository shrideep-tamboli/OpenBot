{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen3.5:4b",
  "small_model": "ollama/qwen3.5:4b",
  "enabled_providers": ["ollama"],

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (this Mac)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen3.5 4B",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },

  "autoupdate": false,
  "share": "disabled",

  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",

    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",

    "webfetch": "allow",
    "websearch": "allow",

    "question": "deny",

    "external_directory": "deny"
  }
}
